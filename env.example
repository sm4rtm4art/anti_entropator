# Anti-Entropator Environment Configuration
# Copy this file to .env and replace all CHANGE_ME values.
#
# Suggested secret generation:
#   openssl rand -base64 32

# RustFS (S3-compatible storage)
RUSTFS_ACCESS_KEY=CHANGE_ME_ACCESS_KEY
RUSTFS_SECRET_KEY=CHANGE_ME_SECRET_KEY_32_PLUS_CHARS

# Postgres (Lakekeeper backend)
POSTGRES_USER=lakekeeper
POSTGRES_PASSWORD=CHANGE_ME_STRONG_POSTGRES_PASSWORD
POSTGRES_DB=lakekeeper

# Lakekeeper (Iceberg REST Catalog)
# Used to encrypt sensitive values stored in Postgres.
LAKEKEEPER_PG_ENCRYPTION_KEY=CHANGE_ME_32_PLUS_CHAR_RANDOM_KEY

# For local development only. Do not use "allowall" in shared or public environments.
LAKEKEEPER_AUTHZ_BACKEND=allowall

# Local port bindings
#
# Keep ANTI_BIND_HOST=127.0.0.1 for local/default use. Do not set this to
# 0.0.0.0 unless a reviewed shared/public deployment profile, firewall,
# non-allowall auth, and managed secret injection are in place.
ANTI_BIND_HOST=127.0.0.1
RUSTFS_API_PORT=8200
RUSTFS_CONSOLE_PORT=8210
POSTGRES_PORT=8300
LAKEKEEPER_PORT=8100

# Anti-Entropator settings
# If you override RUSTFS_API_PORT or LAKEKEEPER_PORT for local delivery slots,
# update these endpoints to match the selected slot.
ANTI_ENTROPATOR_S3_ENDPOINT=http://localhost:8200
ANTI_ENTROPATOR_CATALOG_ENDPOINT=http://localhost:8100
ANTI_ENTROPATOR_S3_REGION=eu-central-1
ANTI_ENTROPATOR_BUCKET=anti-entropator
ANTI_ENTROPATOR_WAREHOUSE=anti-entropator

