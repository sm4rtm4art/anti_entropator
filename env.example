# Anti-Entropator Environment Configuration
# Copy this file to .env and adjust values as needed

# RustFS (S3-compatible storage)
RUSTFS_ROOT_USER=antiuser
RUSTFS_ROOT_PASSWORD=antipassword

# Postgres (Nessie backend)
POSTGRES_USER=nessie
POSTGRES_PASSWORD=nessie
POSTGRES_DB=nessie

# Anti-Entropator settings
ANTI_ENTROPATOR_S3_ENDPOINT=http://localhost:9000
ANTI_ENTROPATOR_NESSIE_ENDPOINT=http://localhost:19120/api/v1
ANTI_ENTROPATOR_BUCKET=anti-entropator
ANTI_ENTROPATOR_WAREHOUSE=s3://anti-entropator/warehouse

