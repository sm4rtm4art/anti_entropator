# Anti-Entropator Environment Configuration
# Copy this file to .env and adjust values as needed

# RustFS (S3-compatible storage)
RUSTFS_ACCESS_KEY=antiuser
RUSTFS_SECRET_KEY=antipassword

# Postgres (Lakekeeper backend)
POSTGRES_USER=lakekeeper
POSTGRES_PASSWORD=lakekeeper
POSTGRES_DB=lakekeeper

# Lakekeeper (Iceberg REST Catalog)
# IMPORTANT: This is used to encrypt secrets stored in Postgres.
# For anything beyond local testing, set a strong random value.
LAKEKEEPER_PG_ENCRYPTION_KEY=This-is-NOT-Secure!

# Anti-Entropator settings
ANTI_ENTROPATOR_S3_ENDPOINT=http://localhost:19000
ANTI_ENTROPATOR_CATALOG_ENDPOINT=http://localhost:8181
ANTI_ENTROPATOR_BUCKET=anti-entropator
ANTI_ENTROPATOR_WAREHOUSE=anti-entropator

