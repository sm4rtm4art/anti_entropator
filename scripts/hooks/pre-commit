#!/usr/bin/env bash
# Local pre-commit gate: fmt, clippy, a test typecheck (cargo test --no-run),
# and markdownlint when markdown files are staged. The tests themselves run in
# the pre-push hook.
set -euo pipefail

echo "==> pre-commit: cargo fmt --check"
cargo fmt --all -- --check

echo "==> pre-commit: cargo clippy"
cargo clippy --all-targets --all-features -- -D warnings

echo "==> pre-commit: cargo test --no-run"
cargo test --all-features --no-run

if git diff --cached --name-only --diff-filter=ACMR | grep -qE '\.(md|mdc)$'; then
    if command -v markdownlint-cli2 >/dev/null 2>&1; then
        echo "==> pre-commit: markdownlint"
        markdownlint-cli2 --config .config/lint/markdownlint-cli2.yaml
    else
        echo "==> pre-commit: markdownlint-cli2 not installed, skipping (CI will lint)"
    fi
fi

echo "==> pre-commit: all checks passed"
